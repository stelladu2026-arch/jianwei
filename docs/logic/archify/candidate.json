  "cards": [
    {
      "dot": "cyan",
      "title": "先读主路径",
      "items": [
        "确认范围 → 规划与取证 → 机会和反证 → 引用检查 → 待人工确认的草稿。",
        "图中展示新研究的 Harness 路径；历史执行器仍保留。"
      ]
    },
    {
      "dot": "emerald",
      "title": "执行边界",
      "items": [
        "模型与来源请求在调用前预留预算；暂停、取消和输入版本变更优先。",
        "复用已确认的操作回执；结果不明时禁止自动重发。后台推进采用有界接力。"
      ]
    },
    {
      "dot": "amber",
      "title": "如何理解图上的证据",
      "items": [
        "节点可查看固定代码版本的来源；箭头表示源码支持的责任关系，未绘制每个返回响应。",
        "语义与付费仍需人工核查；图不是市场或真实全链路验收报告。",
        "Turso 对应 Node 部署；原 Cloudflare / D1 兼容路径未在此展开。"
      ]
    }
  ]
